{
  "name": "cos-old-school",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @cos/api --filter @cos/web dev",
    "dev:api": "pnpm --filter @cos/api dev",
    "dev:web": "pnpm --filter @cos/web dev",
    "db:migrate": "pnpm --filter @cos/api db:migrate",
    "db:seed": "pnpm --filter @cos/api db:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:realtime && pnpm run test:e2e",
    "test:unit": "pnpm --filter @cos/api test:unit && pnpm --filter @cos/web test:unit",
    "test:integration": "pnpm --filter @cos/api test:integration",
    "test:realtime": "pnpm --filter @cos/api test:realtime",
    "test:e2e": "pnpm --filter @cos/web test:e2e",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
